# 複製到 Zeabur 的「環境變數」頁面。不要把真正的值放進 Git。

# Zeabur 上的 PostgreSQL 連線字串（加入 PostgreSQL 服務後可直接引用 ${POSTGRES_CONNECTION_STRING}）
DATABASE_URL=postgres://user:password@host:5432/vault

# 32 bytes 隨機值：openssl rand -base64 32
SERVER_SECRET=

# 註冊碼：openssl rand -hex 16。建立完自己的帳號後「刪掉這個變數」即可關閉註冊
REGISTRATION_CODE=

# Cloudflare R2（R2 → 管理 API 權杖 → 建立「物件讀寫」權杖，只限這一個 bucket）
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=secure-vault
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# 選填
# MAX_STORAGE_BYTES=53687091200   # 總容量上限，預設 50GB
# MAX_FILE_BYTES=10737418240      # 單一檔案上限，預設 10GB
# SESSION_TTL_DAYS=30
# AUTH_RATE_LIMIT_PER_MINUTE=10
